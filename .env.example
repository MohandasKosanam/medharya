# Optional server-side model provider. Keep real credentials out of source control.
MEDHARYA_AI_API_KEY=
MEDHARYA_AI_MODEL=
MEDHARYA_AI_BASE_URL=https://api.openai.com/v1
MEDHARYA_AI_TIMEOUT_MS=15000

# Set to 1 for offline smoke tests; it disables configured external providers.
MEDHARYA_DISABLE_EXTERNAL_PROVIDERS=0

# Optional live research provider. Leave blank to show the explicit unavailable state.
BRAVE_SEARCH_API_KEY=

# Optional server-side prototype repository path. Default: ./data/medharya-server.json
MEDHARYA_SERVER_DATA_FILE=
