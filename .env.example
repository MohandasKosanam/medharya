# Select the server-side chat provider. Keep real credentials out of source control.
MEDHARYA_AI_PROVIDER=openai-compatible
MEDHARYA_AI_API_KEY=
MEDHARYA_AI_MODEL=
# This can be a hosted GPU worker, including a Runpod worker that exposes the
# documented OpenAI-compatible chat-completions contract. Use its API root or
# the full /chat/completions URL; do not use a dashboard URL.
MEDHARYA_AI_BASE_URL=https://api.openai.com/v1
MEDHARYA_AI_TIMEOUT_MS=15000

# Local Ollama provider. Select with MEDHARYA_AI_PROVIDER=ollama.
# Keep Ollama bound to loopback; the adapter rejects non-loopback URLs.
MEDHARYA_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEDHARYA_OLLAMA_MODEL=qwen3:4b
MEDHARYA_OLLAMA_TIMEOUT_MS=30000

# Medharya Alpha FastAPI service. Select with MEDHARYA_AI_PROVIDER=alpha.
# native sends the documented /chat request; openai-compatible sends the Colab
# /v1/chat/completions request with OpenAI messages/model/max_tokens/temperature.
MEDHARYA_ALPHA_PROTOCOL=native
MEDHARYA_ALPHA_BASE_URL=
MEDHARYA_ALPHA_API_KEY=
MEDHARYA_ALPHA_MODEL=medharya-alpha-v0.1
MEDHARYA_ALPHA_BASE_MODEL=Qwen3-8B
MEDHARYA_ALPHA_ADAPTER_VERSION=Medharya Alpha v0.1
MEDHARYA_ALPHA_HEALTH_PATH=/health
# Leave blank for the protocol default: /chat for native, /v1/chat/completions
# for openai-compatible.
MEDHARYA_ALPHA_CHAT_PATH=
MEDHARYA_ALPHA_TIMEOUT_MS=15000
MEDHARYA_ALPHA_MAX_CONCURRENT=4
MEDHARYA_ALPHA_MAX_OUTPUT_TOKENS=900
# Keep 0 in deployment. Set 1 only for an explicitly local HTTP service.
MEDHARYA_ALPHA_ALLOW_INSECURE_LOCAL=0

# Set to 1 for offline smoke tests; it disables configured external providers.
MEDHARYA_DISABLE_EXTERNAL_PROVIDERS=0

# Optional live research provider. Leave blank to show the explicit unavailable state.
BRAVE_SEARCH_API_KEY=

# Server-only PostgreSQL repository. Required when NODE_ENV=production. Apply
# db/migrations/001_initial.sql before starting a production instance.
DATABASE_URL=
# When the Vercel Supabase integration is connected, the app also accepts its
# server-only POSTGRES_PRISMA_URL (pooled) variable automatically. Older
# project-prefixed integration variables are accepted as well.
# Set this to 0 only for an explicitly trusted managed provider whose TLS CA is
# unavailable in the runtime. Explicit DATABASE_URL remains strict by default.
MEDHARYA_DATABASE_SSL_REJECT_UNAUTHORIZED=1

# Local/offline repository path. Used only when NODE_ENV is not production and
# DATABASE_URL is blank. Default: ./data/medharya-server.json
MEDHARYA_SERVER_DATA_FILE=
